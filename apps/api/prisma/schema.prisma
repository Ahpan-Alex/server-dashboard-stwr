generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(64)
  nom       String   @db.VarChar(200)
  nif       String?  @db.VarChar(64)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  sessions      Session[]
  audits        AuthAudit[]
  businessAudits BusinessAudit[]
  businessState BusinessState?

  @@map("tenants")
}

/** État métier du dashboard (JSON) — sync front ↔ API, isolé par tenant. */
model BusinessState {
  id        String   @id @default(cuid())
  tenantId  String   @unique @map("tenant_id")
  revision  Int      @default(1)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_states")
}

model User {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  email              String    @db.VarChar(255)
  nom                String    @db.VarChar(200)
  role               String    @db.VarChar(64)
  /** Rôles cumulés (acheteur, caissier, facturier, vendeur, …). Vide = dérivé de `role`. */
  roles              Json      @default("[]")
  pointDeVenteIds    Json      @default("[]") @map("point_de_vente_ids")
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  passwordHistory    Json      @default("[]") @map("password_history")
  actif              Boolean   @default(true)
  mfaRequired        Boolean   @default(false) @map("mfa_required")
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  /** Photo de profil (data URL JPEG/PNG/WebP compressée, côté client). */
  photoData          String?   @map("photo_data") @db.LongText
  createdAt          DateTime  @default(now()) @map("created_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  audits      AuthAudit[]
  businessAudits BusinessAudit[]

  @@unique([tenantId, email])
  @@index([email])
  @@map("users")
}

model Session {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  tenantId       String    @map("tenant_id")
  tokenHash      String    @unique @map("token_hash") @db.VarChar(128)
  createdAt      DateTime  @default(now()) @map("created_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  expiresAt      DateTime  @map("expires_at")
  deviceLabel    String    @default("Navigateur") @map("device_label") @db.VarChar(64)
  revokedAt      DateTime? @map("revoked_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("sessions")
}

model AuthAudit {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  email     String?  @db.VarChar(255)
  action    String   @db.VarChar(64)
  detail    String?  @db.VarChar(500)
  ipHint    String?  @map("ip_hint") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("auth_audit")
}

/** Journal d'audit métier — append-only, isolé par tenant, non modifiable. */
model BusinessAudit {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  createdAt       DateTime @default(now()) @map("created_at")
  userId          String?  @map("user_id")
  userNom         String   @map("user_nom") @db.VarChar(200)
  categorie       String   @db.VarChar(32)
  action          String   @db.VarChar(64)
  module          String   @db.VarChar(32)
  objetType       String   @map("objet_type") @db.VarChar(64)
  objetId         String?  @map("objet_id") @db.VarChar(128)
  objetLibelle    String?  @map("objet_libelle") @db.VarChar(255)
  objetHref       String?  @map("objet_href") @db.VarChar(255)
  champ           String?  @db.VarChar(128)
  ancienneValeur  String?  @map("ancienne_valeur") @db.Text
  nouvelleValeur  String?  @map("nouvelle_valeur") @db.Text
  detail          String?  @db.VarChar(500)
  siteId          String?  @map("site_id") @db.VarChar(64)
  siteLibelle     String?  @map("site_libelle") @db.VarChar(200)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, categorie, createdAt])
  @@index([tenantId, module, createdAt])
  @@index([tenantId, objetType, objetId])
  @@index([tenantId, siteId, createdAt])
  @@map("business_audit")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
