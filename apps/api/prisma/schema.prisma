generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(64)
  nom       String   @db.VarChar(200)
  nif       String?  @db.VarChar(64)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  sessions      Session[]
  audits        AuthAudit[]
  businessState BusinessState?

  @@map("tenants")
}

/** État métier du dashboard (JSON) — sync front ↔ API, isolé par tenant. */
model BusinessState {
  id        String   @id @default(cuid())
  tenantId  String   @unique @map("tenant_id")
  revision  Int      @default(1)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_states")
}

model User {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  email              String    @db.VarChar(255)
  nom                String    @db.VarChar(200)
  role               String    @db.VarChar(64)
  pointDeVenteIds    Json      @default("[]") @map("point_de_vente_ids")
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  passwordHistory    Json      @default("[]") @map("password_history")
  actif              Boolean   @default(true)
  mfaRequired        Boolean   @default(false) @map("mfa_required")
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  /** Photo de profil (data URL JPEG/PNG/WebP compressée, côté client). */
  photoData          String?   @map("photo_data") @db.LongText
  createdAt          DateTime  @default(now()) @map("created_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  audits      AuthAudit[]

  @@unique([tenantId, email])
  @@index([email])
  @@map("users")
}

model Session {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  tenantId       String    @map("tenant_id")
  tokenHash      String    @unique @map("token_hash") @db.VarChar(128)
  createdAt      DateTime  @default(now()) @map("created_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  expiresAt      DateTime  @map("expires_at")
  deviceLabel    String    @default("Navigateur") @map("device_label") @db.VarChar(64)
  revokedAt      DateTime? @map("revoked_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("sessions")
}

model AuthAudit {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  email     String?  @db.VarChar(255)
  action    String   @db.VarChar(64)
  detail    String?  @db.VarChar(500)
  ipHint    String?  @map("ip_hint") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("auth_audit")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
