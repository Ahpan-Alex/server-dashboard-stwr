# Copier vers .env (local) ou coller dans Dokploy → Environment.

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=stwr
MYSQL_USER=stwr
MYSQL_PASSWORD=stwr
MYSQL_PORT=3306

# Prisma / API
# En Docker Compose, l'hôte est `mysql` (pas 127.0.0.1).
DATABASE_URL=mysql://stwr:stwr@127.0.0.1:3306/stwr
PORT=3001
NODE_ENV=development

# CORS — origine exacte du frontend (HTTPS en prod, sans slash final)
WEB_ORIGIN=http://localhost:3000

# Session cookie
SESSION_COOKIE_NAME=stwr_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Seed : un seul admin (plus de comptes démo)
ADMIN_EMAIL=ton-email@stwr.mg
ADMIN_PASSWORD=un-mot-de-passe-fort
ADMIN_NOM=Administrateur
RUN_SEED=true

# Envoi documents (optionnel — aussi configurable dans Paramètres → Documents → Envoi)
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@votre-domaine.mg
# SMTP_PASSWORD=
# SMTP_FROM="Négoo <noreply@votre-domaine.mg>"
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
