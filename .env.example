# Copier vers .env (local) ou coller dans Dokploy → Environment.

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=stwr
MYSQL_USER=stwr
MYSQL_PASSWORD=stwr
MYSQL_PORT=3306

# Prisma / API
# En Docker Compose, l'hôte est `mysql` (pas 127.0.0.1).
DATABASE_URL=mysql://stwr:stwr@127.0.0.1:3306/stwr
PORT=3001
NODE_ENV=development

# CORS — origine exacte du frontend (HTTPS en prod, sans slash final)
WEB_ORIGIN=http://localhost:3000

# Session cookie
SESSION_COOKIE_NAME=stwr_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optionnel : .votre-domaine.tld si front et API partagent le même domaine parent
COOKIE_DOMAIN=

# Seed au démarrage du container (idempotent, n'écrase pas l'état métier existant)
RUN_SEED=true

# Dev: expose demoToken on password forgot (mettre false en production)
EXPOSE_DEMO_RESET_TOKEN=true
